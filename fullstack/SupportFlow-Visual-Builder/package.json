{
  "name": "supportflow-visual-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run test && npm run build",
    "prepare": "cd ../.. && husky fullstack/SupportFlow-Visual-Builder/.husky"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{css,json,md,html}": [
      "prettier --check"
    ]
  },
  "description": "A visual decision-tree editor and preview runner for customer-support flows.",
  "main": "eslint.config.js",
  "keywords": [
    "react",
    "decision-tree",
    "visual-editor",
    "svg",
    "customer-support"
  ],
  "author": "Jameson Githinji",
  "license": "ISC"
}
